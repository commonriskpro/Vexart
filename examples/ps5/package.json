{
  "name": "@vexart/ps5-public-consumer",
  "private": true,
  "type": "module",
  "scripts": {
    "demo:source": "bash ../../scripts/ps5-demo/run-app-source.sh",
    "demo:stress": "bash ../../scripts/ps5-demo/run-app-source.sh tests/stress.tsx",
    "demo:packaged": "bash ../../scripts/ps5-demo/run-app-packaged.sh",
    "demo:packaged:verify": "bash ../../scripts/ps5-demo/run-app-packaged.sh verify",
    "demo:packaged:test": "bash ../../scripts/ps5-demo/run-app-packaged.sh test",
    "probe:consumer": "bun --conditions=browser run probes/packaged-consumer.tsx",
