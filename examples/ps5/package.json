    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-typescript": "^7.28.5",
    "babel-preset-solid": "^1.9.0",
    "sharp": "^0.34.5",
    "solid-js": "^1.9.0",
    "typescript": "^5.7.0",
    "vexart": "file:../../dist"
  }
}
