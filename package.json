{
  "name": "vexart",
  "version": "0.11.0-beta.9",
  "description": "Pixel-native terminal rendering engine. Write JSX, get browser-quality UI in your terminal.",
  "repository": {
    "type": "git",
    "url": "https://github.com/commonriskpro/Vexart"
  },
  "type": "module",
  "private": true,
  "workspaces": [
    "packages/*",
    "website"
  ],
  "scripts": {
    "api:update": "rm -rf .api-extractor-temp && tsc -p tsconfig.api.json && bunx api-extractor run --local --config packages/engine/api-extractor.json && bunx api-extractor run --local --config packages/headless/api-extractor.json && bunx api-extractor run --local --config packages/styled/api-extractor.json && bunx api-extractor run --local --config packages/app/api-extractor.json && bun run scripts/normalize-api-reports.ts && bun run gen:types",
    "api:check": "bun run api:update",
    "gen:types": "rm -rf .api-extractor-temp && bun run scripts/gen-types.ts",
    "types:check": "bun run gen:types && git diff --exit-code types/ packages/*/etc/",
    "test": "bun --conditions=browser test --preload ./solid-plugin.ts",
    "typecheck": "tsc --noEmit",
    "rust:build": "cargo build --release",
    "rust:test": "cargo test",
    "build:dist": "bun run scripts/build-dist.ts",
    "pack": "bun run build:dist && cd dist && bun pm pack --ignore-scripts",
    "showcase": "bun --conditions=browser run examples/void-showcase.tsx",
    "pi": "bun --conditions=browser run examples/pi-agent.tsx",
    "effects-showcase": "bun --conditions=browser run examples/effects-showcase.tsx",
    "demo:studio": "bun --conditions=browser run examples/demos/main.tsx studio",
    "demo:mission": "bun --conditions=browser run examples/demos/main.tsx mission",
    "demo:effects": "bun --conditions=browser run examples/demos/main.tsx effects",
    "demo:capture": "bun --conditions=browser run examples/demos/capture.tsx",
    "demo:hero": "bun --conditions=browser run scripts/generate-hero-gif.ts",
    "test:demos": "bun run test ./examples/demos",
    "showcase:legacy": "bun --conditions=browser run examples/showcase-legacy.tsx",
    "facebook": "bun --conditions=browser run examples/facebook-app.tsx",
    "devtools": "bun run packages/internal-devtools/src/server.ts",
    "lint:boundaries": "depcruise packages examples --config .dependency-cruiser.cjs",
    "gen:jsx-runtime": "bun run scripts/gen-jsx-runtime.ts",
    "test:visual": "bun --conditions=browser run scripts/visual-test/runner.ts",
    "test:visual:update": "bun --conditions=browser run scripts/visual-test/runner.ts --update",
    "test:visual:native-render-graph": "bun --conditions=browser run scripts/visual-test/runner.ts --native-render-graph-parity",
    "perf:baseline": "bun --conditions=browser run scripts/perf-baseline.tsx",
    "perf:check": "bun --conditions=browser run scripts/perf-baseline.tsx --check",
    "benchmark": "bun run benchmarks/engine-benchmark.ts",
    "bench:frame-breakdown": "bun --conditions=browser run scripts/frame-breakdown.tsx",
    "bench:dashboard-1080p": "bun --conditions=browser run scripts/frame-breakdown.tsx --frames=300 --warmup=5",
    "perf:transport:shm": "bun --conditions=browser run scripts/frame-breakdown.tsx --frames=60 --warmup=5 --transport=shm && bun run scripts/frame-breakdown-gate.ts --transport=shm",
    "perf:transport:file": "bun --conditions=browser run scripts/frame-breakdown.tsx --frames=60 --warmup=5 --transport=file && bun run scripts/frame-breakdown-gate.ts --transport=file",
    "perf:transport:check": "bun run perf:transport:shm && bun run perf:transport:file",
    "validate:terminal-transport": "bun --conditions=browser run scripts/terminal-transport-matrix.ts",
    "validate:terminal-transport:bench": "bun --conditions=browser run scripts/terminal-transport-matrix.ts --bench --frames=60 --warmup=5",
    "perf:frame-orchestrator": "bun --conditions=browser run scripts/frame-orchestrator-bench.ts",
    "perf:compare": "bun run scripts/perf-compare.ts --before scripts/frame-breakdown-pre-optimization.json --after scripts/frame-breakdown-report.json",
    "perf:compare:fail": "bun run scripts/perf-compare.ts --before scripts/frame-breakdown-pre-optimization.json --after scripts/frame-breakdown-report.json --fail-on-regression",
    "perf:snapshot": "bun --conditions=browser run scripts/frame-breakdown.tsx --frames=100 --warmup=10",
    "test:golden": "bun --conditions=browser run scripts/visual-correctness-gate.tsx",
    "test:golden:check": "bun --conditions=browser run scripts/visual-correctness-gate.tsx --check",
    "check:retained-cleanup": "bun run scripts/check-retained-cleanup.ts",
    "docs:dev": "bun run --cwd website dev",
    "docs:build": "bun run --cwd website build",
    "docs:preview": "bun run --cwd website preview",
    "changeset": "changeset",
    "changeset:empty": "changeset add --empty",
    "changeset:version": "changeset version"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-typescript": "^7.28.5",
    "@changesets/cli": "^3.0.2",
    "@microsoft/api-extractor": "^7.52.10",
    "@napi-rs/canvas": "^1.0.8",
    "@types/bun": "^1.3.12",
    "babel-preset-solid": "^1.9.0",
    "dependency-cruiser": "^16.10.0",
    "esbuild": "^0.28.0",
    "sharp": "^0.34.5",
    "solid-js": "^1.9.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "bun": ">=1.1.0"
  },
  "license": "SEE LICENSE IN LICENSE",
  "dependencies": {
    "flexily": "workspace:*",
    "marked": "^18.0.0"
  },
  "overrides": {
    "hono": "^4.12.14"
  }
}
